{
  "manifest_version": 3,
  "name": "ServiceRoute-Solo",
  "version": "0.3.4",
  "description": "User-centric service availability and connectivity route checker.",
  "permissions": ["storage", "idle", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "offline_enabled": true
}
